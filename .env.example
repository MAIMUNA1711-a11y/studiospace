# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB (use your own Atlas URI; never commit the real one) ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=studiospace

# ---- CORS: comma separated list of allowed browser origins ----
CLIENT_URL=http://localhost:3000

# ---- JWT verification (tokens are issued by Better Auth's jwt plugin on the Next.js app) ----
# JWKS endpoint exposed by Better Auth on the client app
JWKS_URL=http://localhost:3000/api/auth/jwks
# Better Auth uses its baseURL as issuer/audience by default
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000
# Optional: name of an HTTPOnly cookie that may carry the JWT (Authorization: Bearer is also accepted)
JWT_COOKIE_NAME=studiospace_token

# ---- Booking rules ----
# Offset (minutes from UTC) used to decide whether a requested slot is in the past. Dhaka = 360
BOOKING_UTC_OFFSET_MINUTES=360
